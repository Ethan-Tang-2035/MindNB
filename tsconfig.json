{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "vite/client",
      "node"
    ],
    "strict": true,
    "noUnusedLocals": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "src",
    "api",
    "server",
    "desktop",
    "tests/desktop",
    "tests/web",
    "mcp",
    "playwright.*.config.ts",
    "vite.config.ts",
    "scripts",
    "tests/helpers"
  ]
}
